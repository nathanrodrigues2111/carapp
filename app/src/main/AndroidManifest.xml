<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Phone GO: mobile data state (TelephonyManager.isDataEnabled) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS link (phone sends, tablet receives and mocks) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Tablet: the phone hotspot as a Wi-Fi suggestion (Drive.join) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Tablet: the phone's GO must reach it in deep sleep (Doze cuts app network otherwise). One system dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" tools:ignore="MockLocation,ProtectedPermissions" />

    <!-- Reverse camera (tablet). AUSBC needs CAMERA even for UVC, the webcam mic needs RECORD_AUDIO. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:backupAgent=".Backup"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.LazyCar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".DebugActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".GoActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Translucent" />

        <receiver
            android:name=".GoWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/go_widget_info" />
        </receiver>



        <service
            android:name=".GoService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="one-tap car setup: hotspot, mobile data, location, tablet" />
        </service>

        <!-- Tablet "Drive" widget. Role.applyComponents disables it on the phone. -->
        <receiver
            android:name=".DriveWidget"
            android:exported="true"
            android:label="Drive">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/drive_widget_info" />
        </receiver>

        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- Optional helper (Drive.kt): phone GO / Shut down toggles, tablet GO wake, stereo, saved pair. -->
        <service
            android:name=".SplitService"
            android:exported="true"
            android:label="CarApp helper"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/split_service" />
        </service>

        <!-- Reverse camera, ported from RearView -->
        <activity
            android:name=".rear.RearActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.RearView"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- USB attach trigger: the reverse light powers the webcam, which launches the camera.
             Role.applyComponents disables this alias on the phone. -->
        <activity-alias
            android:name=".rear.UsbLaunch"
            android:exported="true"
            android:targetActivity=".rear.RearActivity">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity-alias>

        <activity
            android:name=".rear.RearSettingsActivity"
            android:exported="false"
            android:label="Camera settings"
            android:parentActivityName=".rear.RearActivity"
            android:theme="@style/Theme.RearView.Settings" />

        <activity
            android:name=".rear.RecordingsActivity"
            android:exported="false"
            android:label="Recordings"
            android:parentActivityName=".rear.RearActivity"
            android:theme="@style/Theme.RearView.Settings" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rv_file_paths" />
        </provider>

        <!-- GPS link, ported from LazyGPS -->
        <service
            android:name=".gps.GpsService"
            android:exported="false"
            android:foregroundServiceType="location|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="phone GPS sharing started from boot before location is allowed" />
        </service>

        <receiver
            android:name=".gps.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Phone side of the phone-tablet link (runs between app open or GO and Shut down) -->
        <service
            android:name=".LinkService"
            android:exported="false" />

    </application>
</manifest>
