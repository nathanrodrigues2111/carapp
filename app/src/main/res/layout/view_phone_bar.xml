<?xml version="1.0" encoding="utf-8"?>
<!-- Phone top bar: app tile and name left, Debug and Settings right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="80dp" android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView android:id="@+id/appTile" android:layout_width="56dp" android:layout_height="56dp"
        android:background="@drawable/bg_glass" android:importantForAccessibility="no" android:padding="14dp"
        android:src="@drawable/ic_car" />
    <TextView style="@style/T.Display" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="@dimen/sp4" android:text="CarApp"
        android:textSize="@dimen/t_headline" />
    <ImageButton android:id="@+id/debugBtn" style="@style/CarIconBtn" android:contentDescription="Debug"
        android:src="@drawable/ic_bug" app:tint="?attr/carTextDim" />
    <ImageButton android:id="@+id/settingsBtn" style="@style/CarIconBtn" android:contentDescription="Settings"
        android:src="@drawable/ic_settings" app:tint="?attr/carTextDim" />
</LinearLayout>
