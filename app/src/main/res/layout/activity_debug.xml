<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/carBg"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/sp4"
            android:paddingBottom="@dimen/sp6" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyBtn"
        style="@style/CarButton"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/sp4"
        android:layout_marginBottom="@dimen/sp3"
        android:text="@string/debug_copy" />
</LinearLayout>
