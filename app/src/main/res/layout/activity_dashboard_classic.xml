<?xml version="1.0" encoding="utf-8"?>
<!-- Classic tablet player (Player style: Classic). Same ids as activity_dashboard. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/carBg">

    <ImageView android:id="@+id/npBackdrop" android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_scrim" />

    <!-- One layout: vertical in the split next to Maps, art left / controls right when wide (DashboardActivity flips it). -->
    <LinearLayout android:id="@+id/body" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="@dimen/sp4">
        <FrameLayout android:id="@+id/artFrame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <com.google.android.material.card.MaterialCardView android:id="@+id/npArtBox" android:layout_width="match_parent" android:layout_height="match_parent"
            app:cardBackgroundColor="?attr/carSurface" app:cardCornerRadius="@dimen/r_m" app:cardElevation="12dp"
            app:strokeWidth="0dp">
            <ImageView android:id="@+id/npArt" android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="Album art. Tap to play or pause, swipe for next or previous"
                android:scaleType="centerCrop" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|start" android:layout_margin="@dimen/sp4" android:orientation="vertical">
                <TextView android:id="@+id/npTitle" style="@style/T.Title" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/bg_chip_dark"
                    android:paddingHorizontal="@dimen/sp3" android:paddingVertical="@dimen/sp1"
                    android:text="Nothing playing" android:textSize="@dimen/t_headline" android:textStyle="bold" />
                <TextView android:id="@+id/npArtist" style="@style/T.Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp1"
                    android:background="@drawable/bg_chip_dark" android:paddingHorizontal="@dimen/sp3"
                    android:paddingVertical="@dimen/sp1" android:textColor="?attr/carText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
        <LinearLayout android:id="@+id/side" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <com.google.android.material.slider.Slider android:id="@+id/npSeek" style="@style/CarSlider"
                android:valueTo="1" android:contentDescription="Seek" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/sp4">
                <TextView android:id="@+id/npPos" style="@style/T.Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/bg_chip_dark"
                    android:paddingHorizontal="@dimen/sp2" android:textColor="?attr/carText" />
                <TextView android:id="@+id/npDur" style="@style/T.Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="end" android:background="@drawable/bg_chip_dark"
                    android:paddingHorizontal="@dimen/sp2" android:textColor="?attr/carText" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp4" android:gravity="center" android:orientation="horizontal">
                <ImageButton android:id="@+id/npPrev" android:layout_width="88dp" android:layout_height="88dp"
                    android:background="@drawable/bg_circle_dark" android:contentDescription="Previous" android:padding="26dp"
                    android:scaleType="fitCenter" android:src="@drawable/ic_skip_prev" app:tint="#FFFFFFFF" />
                <ImageButton android:id="@+id/npPlay" android:layout_width="@dimen/car_play" android:layout_height="@dimen/car_play"
                    android:layout_marginHorizontal="@dimen/sp6" android:background="@drawable/bg_circle_accent"
                    android:contentDescription="Play or pause" android:elevation="16dp" android:padding="32dp"
                    android:scaleType="fitCenter" android:src="@drawable/ic_play" />
                <ImageButton android:id="@+id/npNext" android:layout_width="88dp" android:layout_height="88dp"
                    android:background="@drawable/bg_circle_dark" android:contentDescription="Next" android:padding="26dp"
                    android:scaleType="fitCenter" android:src="@drawable/ic_skip_next" app:tint="#FFFFFFFF" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical"
                android:orientation="horizontal" >
                <TextClock style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format12Hour="h:mm" android:format24Hour="H:mm" android:textStyle="bold" />
                <TextView android:id="@+id/speedText" style="@style/T.Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="@dimen/sp3" android:text="-- km/h" />
                <LinearLayout android:id="@+id/statusRow" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground" android:contentDescription="GPS and stream status, opens settings"
                    android:gravity="center" android:paddingHorizontal="@dimen/sp3">
                    <View android:id="@+id/stGpsDot" style="@style/Dot" android:layout_width="8dp" android:layout_height="8dp" />
                    <View android:id="@+id/stStreamDot" style="@style/Dot" android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_marginStart="@dimen/sp2" />
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <ImageButton android:id="@+id/npLibrary" style="@style/CarIconBtn" android:contentDescription="Library"
                    android:src="@drawable/ic_library" />
                <ImageButton android:id="@+id/settingsBtn" style="@style/CarIconBtn" android:contentDescription="Settings"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/setupBanner" style="@style/T.Label" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="@dimen/sp6"
        android:maxWidth="520dp" android:minHeight="48dp" android:maxLines="3" android:background="@drawable/bg_chip_dark"
        android:gravity="center_vertical" android:padding="@dimen/sp3" android:textColor="?attr/carText"
        android:visibility="gone" />
</FrameLayout>
