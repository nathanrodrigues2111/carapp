<?xml version="1.0" encoding="utf-8"?>
<!-- Compact status tile: 20dp icon, short title, one status word, dot. Filled by MainActivity.tile(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:background="@drawable/bg_glass"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/sp4">
    <ImageView android:id="@+id/tileIcon" android:layout_width="20dp" android:layout_height="20dp"
        android:importantForAccessibility="no" app:tint="?attr/carTextDim" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="@dimen/sp3" android:orientation="vertical">
        <TextView android:id="@+id/tileTitle" style="@style/SetTitle" />
        <TextView android:id="@+id/tileSub" style="@style/SetSub" />
    </LinearLayout>
    <View android:id="@+id/tileDot" style="@style/Dot" android:layout_width="8dp" android:layout_height="8dp" />
</LinearLayout>
