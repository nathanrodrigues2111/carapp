<?xml version="1.0" encoding="utf-8"?>
<!-- Phone home status tile: icon, title, state, dot. Filled by MainActivity.tile(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Glass" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/sp4">
    <ImageView android:id="@+id/tileIcon" android:layout_width="28dp" android:layout_height="28dp"
        android:importantForAccessibility="no" app:tint="?attr/carTextDim" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="@dimen/sp3" android:orientation="vertical">
        <TextView android:id="@+id/tileTitle" style="@style/T.Title" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tileSub" style="@style/T.Body" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
    <View android:id="@+id/tileDot" style="@style/Dot" android:layout_width="8dp" android:layout_height="8dp" />
</LinearLayout>
