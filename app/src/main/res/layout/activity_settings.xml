<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: grouped sections. Appearance, Audio, GPS, Launch, Camera, Car mode, Advanced. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/carBg"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="8dp">
        <ImageButton android:id="@+id/backBtn" style="@style/CarIconBtn" android:contentDescription="Back"
            android:src="@drawable/ic_back_round" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:fontFamily="sans-serif" android:letterSpacing="-0.02" android:text="Settings"
            android:textColor="?attr/carText" android:textSize="32sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
    <!-- Tablet: section list, filled by SettingsActivity; tap scrolls to the section -->
    <LinearLayout android:id="@+id/navList" android:layout_width="240dp" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingHorizontal="@dimen/sp4" android:visibility="gone" />
    <ScrollView android:id="@+id/settingsScroll" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:clipToPadding="false" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="@dimen/sp4" android:paddingBottom="@dimen/sp6">

            <TextView style="@style/SectionHeader" android:text="Audio" />
            <LinearLayout style="@style/Glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
                <include layout="@layout/view_outputs" />
                <TextView android:id="@+id/audioAnchor" style="@style/Caption" android:layout_marginTop="@dimen/sp2" android:text="Hardware volume buttons keep working as usual" />
            </LinearLayout>

            <TextView style="@style/SectionHeader" android:text="GPS" />
            <LinearLayout style="@style/Glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/gpsSwitch" style="@style/SettingSwitch" android:text="" />
                <TextView android:id="@+id/gpsCaption" style="@style/Caption" />
                <TextView android:id="@+id/gpsLive" style="@style/T.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:maxLines="3" />

            </LinearLayout>

            <TextView style="@style/SectionHeader" android:text="Drive" />
            <LinearLayout style="@style/Glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/openBootSwitch" style="@style/SettingSwitch" android:text="Open Maps + player on tablet start" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/openGoSwitch" style="@style/SettingSwitch" android:text="Open Maps + player on GO" />
                <TextView android:id="@+id/driveCaption" style="@style/Caption" android:text="Uses the launcher's saved Maps + CarApp pair" />
                <TextView style="@style/Caption" android:layout_marginTop="@dimen/sp4" android:text="Widget tap opens" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/launchMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeNone"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="None" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeOne"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="One app" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeSplit"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Split pair" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <LinearLayout
                        android:id="@+id/launchApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">
                    <LinearLayout android:id="@+id/launchARow" style="@style/Row56">
                        <FrameLayout style="@style/IconCircle">
                            <ImageView android:id="@+id/launchAIcon" style="@style/RowIcon" />
                        </FrameLayout>
                        <TextView android:id="@+id/launchAValue" style="@style/RowTitle" />
                        <ImageView style="@style/ChevronIcon" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/launchBRow" style="@style/Row56">
                        <FrameLayout style="@style/IconCircle">
                            <ImageView android:id="@+id/launchBIcon" style="@style/RowIcon" />
                        </FrameLayout>
                        <TextView android:id="@+id/launchBValue" style="@style/RowTitle" />
                        <ImageView style="@style/ChevronIcon" />
                    </LinearLayout>
                        <LinearLayout
                            android:id="@+id/splitExtra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/swapBtn"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Swap sides" />
                            <TextView style="@style/Caption" android:layout_marginTop="12dp" android:text="Split ratio, left : right" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/ratioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ratio50"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="50 : 50" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ratio65"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="65 : 35" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ratio35"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="35 : 65" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                            <TextView android:id="@+id/pairHint" style="@style/Caption" android:layout_marginTop="8dp"
                                android:text="If the split does not open, save the pair once: long press Maps on the home screen, Split screen, pick the other app, then save the app pair." />
                            <LinearLayout android:id="@+id/launchPresetRow" style="@style/Row56" android:layout_marginTop="4dp">
                                <TextView style="@style/RowTitle" android:layout_marginStart="0dp" android:text="Presets" />
                                <ImageView style="@style/ChevronIcon" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

            </LinearLayout>

            <TextView style="@style/SectionHeader" android:text="Camera" android:id="@+id/camSectionHeader" />
            <LinearLayout android:id="@+id/camSection" style="@style/Glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
                <TextView android:id="@+id/camLive" style="@style/T.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="2" />
                <com.google.android.material.button.MaterialButton android:id="@+id/camOpen" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="Open camera" />
                <LinearLayout android:id="@+id/camRow" style="@style/Row56">
                    <TextView style="@style/RowTitle" android:layout_marginStart="0dp" android:textColor="?attr/carText" android:text="Reverse camera settings" />
                    <ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SectionHeader" android:text="Connection" android:id="@+id/carSectionHeader" />
            <LinearLayout android:id="@+id/carSection" style="@style/Glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/ssidBox" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" android:hint="Phone hotspot to join">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ssidField" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
                <!-- Car head unit -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/headunitSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="48dp"
                        android:text="Car head unit"
                        android:textColor="?attr/carText"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/headunitDetected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/carTextDim"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:id="@+id/headunitExtra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
<LinearLayout android:id="@+id/dev3Row" style="@style/Row56" android:layout_marginTop="4dp">
                            <FrameLayout style="@style/IconCircle">
                                <ImageView android:id="@+id/dev3Icon" style="@style/RowIcon" />
                            </FrameLayout>
                            <TextView android:id="@+id/dev3Value" style="@style/RowTitle" android:text="Head unit tablet" />
                            <ImageView style="@style/ChevronIcon" />
                        </LinearLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Head unit IP (optional)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/ipField"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/hotspotSwitch" style="@style/SettingSwitch" android:text="Wi-Fi hotspot" />
                <TextView android:id="@+id/hotspotCaption" style="@style/Caption" android:text="Turns on with GO, restored on STOP" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/mobileSwitch" style="@style/SettingSwitch" android:text="Mobile data" android:layout_marginStart="24dp" android:visibility="gone" />
            </LinearLayout>

            <TextView style="@style/SectionHeader" android:text="Advanced" />
            <LinearLayout style="@style/Glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
                <LinearLayout android:id="@+id/roleRow" style="@style/Row56">
                    <TextView style="@style/RowTitle" android:layout_marginStart="0dp" android:textColor="?attr/carText" android:text="Device role" />
                    <TextView android:id="@+id/roleValue" style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" /><ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" />
                </LinearLayout>
                <LinearLayout android:id="@+id/a11yRow" style="@style/Row56">
                    <ImageView android:id="@+id/a11yIcon" android:layout_width="24dp" android:layout_height="24dp" />
                    <TextView android:id="@+id/a11yText" style="@style/RowTitle" android:textColor="?attr/carText" android:text="Auto-tap ready" />
                </LinearLayout>
                <LinearLayout android:id="@+id/helpRow" style="@style/Row56">
                    <TextView style="@style/RowTitle" android:layout_marginStart="0dp" android:textColor="?attr/carText" android:text="Help" />
                    <ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" />
                </LinearLayout><LinearLayout android:id="@+id/debugRow" style="@style/Row56">
                    <TextView style="@style/RowTitle" android:layout_marginStart="0dp" android:textColor="?attr/carText" android:text="Debug" />
                    <ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/versionText" style="@style/Caption" android:layout_marginTop="16dp" android:gravity="center" />
        </LinearLayout>
    </ScrollView>
    </LinearLayout>
</LinearLayout>
