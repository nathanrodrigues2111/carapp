<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:title="Settings"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Device: role, GPS link, camera -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardBox"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout android:id="@+id/roleRow" style="@style/Row56">
                        <TextView style="@style/RowTitle" android:layout_marginStart="0dp" android:text="Device role" />
                        <TextView
                            android:id="@+id/roleValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/secondaryText"
                            android:textSize="15sp" />
                        <ImageView style="@style/ChevronIcon" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/gpsSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:textColor="@color/white"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/gpsCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/secondaryText"
                        android:textSize="13sp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ssidBox"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Phone hotspot to join">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ssidField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:id="@+id/camRow" style="@style/Row56" android:layout_marginTop="8dp">
                        <TextView style="@style/RowTitle" android:layout_marginStart="0dp" android:text="Reverse camera settings" />
                        <ImageView style="@style/ChevronIcon" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/CardBox"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- AMOLED -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/amoledSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="48dp"
                        android:text="AMOLED black"
                        android:textColor="@color/white"
                        android:textSize="17sp" />

                    <!-- Accent colour -->
                    <LinearLayout
                        android:id="@+id/accentRow"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Accent color"
                            android:textColor="@color/white"
                            android:textSize="17sp" />
                        <View
                            android:id="@+id/accentDot"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/circle_icon_bg" />
                        <ImageView style="@style/ChevronIcon" />
                    </LinearLayout>

                    <!-- Car head unit -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/headunitSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="48dp"
                        android:text="Car head unit"
                        android:textColor="@color/white"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/headunitDetected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/secondaryText"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:id="@+id/headunitExtra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <LinearLayout android:id="@+id/dev3Row" style="@style/Row56" android:layout_marginTop="4dp">
                            <FrameLayout style="@style/IconCircle">
                                <ImageView android:id="@+id/dev3Icon" style="@style/RowIcon" />
                            </FrameLayout>
                            <TextView android:id="@+id/dev3Value" style="@style/RowTitle" android:text="Head unit tablet" />
                            <ImageView style="@style/ChevronIcon" />
                        </LinearLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Head unit IP (optional)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/ipField"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Wi-Fi hotspot -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/hotspotSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="48dp"
                        android:text="Wi-Fi hotspot"
                        android:textColor="@color/white"
                        android:textSize="17sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/hotspotCaption"
                        android:text="Turns on with GO, restored on STOP"
                        android:textColor="@color/secondaryText"
                        android:textSize="13sp" />
                    <!-- Mobile data: indented sub-row, only while hotspot is on -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/mobileSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="Mobile data"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Widget tap opens: nothing, one app, or a split screen pair -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardBox"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">
                    <TextView style="@style/CardLabel" android:text="Widget tap opens" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/launchMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeNone"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="None" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeOne"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="One app" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeSplit"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Split pair" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <LinearLayout
                        android:id="@+id/launchApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">
                    <LinearLayout android:id="@+id/launchARow" style="@style/Row56">
                        <FrameLayout style="@style/IconCircle">
                            <ImageView android:id="@+id/launchAIcon" style="@style/RowIcon" />
                        </FrameLayout>
                        <TextView android:id="@+id/launchAValue" style="@style/RowTitle" />
                        <ImageView style="@style/ChevronIcon" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/launchBRow" style="@style/Row56">
                        <FrameLayout style="@style/IconCircle">
                            <ImageView android:id="@+id/launchBIcon" style="@style/RowIcon" />
                        </FrameLayout>
                        <TextView android:id="@+id/launchBValue" style="@style/RowTitle" />
                        <ImageView style="@style/ChevronIcon" />
                    </LinearLayout>
                        <LinearLayout
                            android:id="@+id/splitExtra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/swapBtn"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Swap sides" />
                            <TextView style="@style/CardLabel" android:layout_marginTop="12dp" android:text="Split ratio, left : right" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/ratioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ratio50"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="50 : 50" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ratio65"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="65 : 35" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ratio35"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="35 : 65" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                            <LinearLayout android:id="@+id/launchPresetRow" style="@style/Row56" android:layout_marginTop="4dp">
                                <TextView style="@style/RowTitle" android:layout_marginStart="0dp" android:text="Presets" />
                                <ImageView style="@style/ChevronIcon" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Accessibility status + Help -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardBox"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">
                    <LinearLayout android:id="@+id/a11yRow" style="@style/Row56">
                        <FrameLayout style="@style/IconCircle">
                            <ImageView android:id="@+id/a11yIcon" style="@style/RowIcon" />
                        </FrameLayout>
                        <TextView android:id="@+id/a11yText" style="@style/RowTitle" android:text="Auto-tap ready" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/helpRow" style="@style/Row56">
                        <FrameLayout style="@style/IconCircle">
                            <ImageView android:id="@+id/helpIcon" style="@style/RowIcon" android:src="@drawable/ic_help" app:tint="@color/white" />
                        </FrameLayout>
                        <TextView style="@style/RowTitle" android:text="Help" />
                        <ImageView style="@style/ChevronIcon" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/debugRow" style="@style/Row56">
                        <FrameLayout style="@style/IconCircle">
                            <ImageView style="@style/RowIcon" android:src="@drawable/ic_settings" app:tint="@color/white" />
                        </FrameLayout>
                        <TextView style="@style/RowTitle" android:text="Debug" />
                        <ImageView style="@style/ChevronIcon" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/secondaryText"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
