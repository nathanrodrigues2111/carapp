<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: small caps header, one card per section, rows with hairlines. Ordered by use in the car. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/carBg" android:orientation="vertical">
    <include layout="@layout/view_top_bar" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <!-- Tablet, wide: section list filled by SettingsActivity; a tap scrolls to the section -->
    <LinearLayout android:id="@+id/navList" android:layout_width="320dp" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingHorizontal="@dimen/sp4" android:visibility="gone" />
    <ScrollView android:id="@+id/settingsScroll" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:clipToPadding="false" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="@dimen/sp4" android:paddingBottom="@dimen/sp6">
            <TextView style="@style/SectionHeader" android:id="@+id/spkHeader" android:text="Car stereo" />
            <LinearLayout style="@style/SetCard" android:id="@+id/spkCard">
                <LinearLayout style="@style/SetRow.Stack" android:id="@+id/btBox" android:visibility="gone">
                    <TextView android:id="@+id/btNote" style="@style/SetSub" android:maxLines="2" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btEnable" style="@style/CarButton"
                        android:layout_marginTop="@dimen/sp2" android:text="Turn on Bluetooth" />
                </LinearLayout>
                <LinearLayout android:id="@+id/outJblRow" style="@style/SetRow" android:clickable="true" android:focusable="true"><ImageView android:id="@+id/outJblIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="@dimen/sp4" android:src="@drawable/ic_speaker" app:tint="?attr/carText" /><LinearLayout style="@style/SetTexts"><TextView style="@style/SetTitle" android:text="Bluetooth device" /><TextView style="@style/SetSub" android:id="@+id/outJblName" /></LinearLayout><ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" /></LinearLayout>
            </LinearLayout>
            <TextView style="@style/SectionHeader" android:id="@+id/driveHeader" android:text="Drive" />
            <LinearLayout style="@style/SetCard" android:id="@+id/driveCard">
                <LinearLayout android:id="@+id/pairRow" style="@style/SetRow" android:clickable="true" android:focusable="true"><LinearLayout style="@style/SetTexts"><TextView style="@style/SetTitle" android:text="Open on GO" /><TextView style="@style/SetSub" android:id="@+id/pairSub" /></LinearLayout><TextView android:id="@+id/pairValue" style="@style/SetValue" /><ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" /></LinearLayout>
            </LinearLayout>
            <TextView style="@style/SectionHeader" android:text="GPS" />
            <LinearLayout style="@style/SetCard">
                <LinearLayout android:id="@+id/rowGps" style="@style/SetRow"><LinearLayout style="@style/SetTexts"><TextView style="@style/SetTitle" android:id="@+id/gpsTitle" /><TextView style="@style/SetSub" android:id="@+id/gpsLive" /></LinearLayout><com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/gpsSwitch" style="@style/SetSwitch" /></LinearLayout>
            </LinearLayout>
            <TextView style="@style/SectionHeader" android:id="@+id/camSectionHeader" android:text="Camera" />
            <LinearLayout style="@style/SetCard" android:id="@+id/camSection">
                <LinearLayout android:id="@+id/camOpen" style="@style/SetRow" android:clickable="true" android:focusable="true"><LinearLayout style="@style/SetTexts"><TextView style="@style/SetTitle" android:text="Open camera" /><TextView style="@style/SetSub" android:id="@+id/camLive" /></LinearLayout><ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" /></LinearLayout>
                <LinearLayout android:id="@+id/camRow" style="@style/SetRow" android:clickable="true" android:focusable="true"><LinearLayout style="@style/SetTexts"><TextView style="@style/SetTitle" android:text="Camera settings" /><TextView style="@style/SetSub" android:text="Guidelines, recording, theme" /></LinearLayout><ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" /></LinearLayout>
            </LinearLayout>
            <TextView style="@style/SectionHeader" android:id="@+id/carSectionHeader" android:text="Connection" />
            <LinearLayout style="@style/SetCard" android:id="@+id/carSection">
                <FrameLayout style="@style/SetRow" android:background="@null"><com.google.android.material.textfield.TextInputLayout android:id="@+id/ssidBox" style="@style/CarField" android:hint="Phone hotspot to join"><com.google.android.material.textfield.TextInputEditText android:id="@+id/ssidField" style="@style/CarFieldText" /></com.google.android.material.textfield.TextInputLayout></FrameLayout>
                <FrameLayout style="@style/SetRow" android:background="@null"><com.google.android.material.textfield.TextInputLayout android:id="@+id/hotspotPassBox" style="@style/CarField" android:hint="Hotspot password (blank if open)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/hotspotPassField" style="@style/CarFieldText" android:inputType="textPassword" /></com.google.android.material.textfield.TextInputLayout></FrameLayout>
            </LinearLayout>
            <TextView style="@style/SectionHeader" android:text="Advanced" />
            <LinearLayout style="@style/SetCard">
                <LinearLayout android:id="@+id/roleRow" style="@style/SetRow" android:clickable="true" android:focusable="true"><LinearLayout style="@style/SetTexts"><TextView style="@style/SetTitle" android:text="Device role" /><TextView style="@style/SetSub" android:text="Phone or tablet" /></LinearLayout><TextView android:id="@+id/roleValue" style="@style/SetValue" /><ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" /></LinearLayout>
                <LinearLayout android:id="@+id/shutRow" style="@style/SetRow" android:clickable="true" android:focusable="true"><LinearLayout style="@style/SetTexts"><TextView style="@style/SetTitle" android:text="Shut down" /><TextView style="@style/SetSub" android:text="Put both devices back as they were and stop CarApp" /></LinearLayout></LinearLayout>
                <LinearLayout android:id="@+id/helpRow" style="@style/SetRow" android:clickable="true" android:focusable="true"><LinearLayout style="@style/SetTexts"><TextView style="@style/SetTitle" android:text="Help" /><TextView style="@style/SetSub" android:text="Setup steps" /></LinearLayout><ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" /></LinearLayout>
                <LinearLayout android:id="@+id/debugRow" style="@style/SetRow" android:clickable="true" android:focusable="true"><LinearLayout style="@style/SetTexts"><TextView style="@style/SetTitle" android:text="Debug" /><TextView style="@style/SetSub" android:text="Status of every part" /></LinearLayout><ImageView style="@style/ChevronIcon" app:tint="?attr/carTextDim" /></LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/versionText" style="@style/T.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp6" android:gravity="center" />
        </LinearLayout>
    </ScrollView>
    </LinearLayout>
</LinearLayout>
