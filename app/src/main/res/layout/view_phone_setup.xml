<?xml version="1.0" encoding="utf-8"?>
<!-- First-run setup, only while something is missing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setupCard"
    style="@style/Glass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    android:visibility="gone">
    <TextView android:id="@+id/setupTitle" style="@style/T.Title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textStyle="bold" />
    <TextView android:id="@+id/setupBody" style="@style/T.Label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp"
        android:maxLines="6" />
    <com.google.android.material.button.MaterialButton android:id="@+id/setupBtn"
        style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
        android:layout_height="56dp" android:layout_marginTop="8dp" />
</LinearLayout>
