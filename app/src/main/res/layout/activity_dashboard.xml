<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- Header: brand left, cog right (same as the phone home) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="4dp">
            <ImageView
                android:id="@+id/brandIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/ic_car_glyph" />
            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Missing permissions -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/setupCard"
            style="@style/CardBox"
            android:layout_marginBottom="12dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permissions needed"
                    android:textColor="@color/white"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/setupBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/secondaryText"
                    android:textSize="15sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setupBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Grant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Now playing on the phone: controls whatever player it uses -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/npCard"
            style="@style/CardBox"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="24dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/npArtBox"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    app:cardBackgroundColor="@color/iconCircle"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:id="@+id/npArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Album art"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/npLabel" style="@style/CardLabel" android:text="Now playing" />
                    <TextView
                        android:id="@+id/npTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="32sp" />
                    <TextView
                        android:id="@+id/npArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/secondaryText"
                        android:textSize="20sp" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/npSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:valueFrom="0"
                        android:valueTo="1"
                        app:labelBehavior="gone" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView android:id="@+id/npPos" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:textColor="@color/secondaryText" android:textSize="14sp" />
                        <TextView android:id="@+id/npDur" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="end" android:layout_marginEnd="12dp" android:textColor="@color/secondaryText" android:textSize="14sp" />
                    </FrameLayout>
                    <LinearLayout
                        android:id="@+id/npButtons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/npVolDown" style="@style/NpButton"
                            android:contentDescription="Phone volume down" app:icon="@drawable/ic_vol_down" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/npPrev" style="@style/NpButton"
                            android:contentDescription="Previous" app:icon="@drawable/ic_skip_prev" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/npPlay"
                            style="@style/Widget.Material3.Button.Icon"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_marginHorizontal="8dp"
                            android:contentDescription="Play or pause"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:cornerRadius="44dp"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="44dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/npNext" style="@style/NpButton"
                            android:contentDescription="Next" app:icon="@drawable/ic_skip_next" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/npVolUp" style="@style/NpButton"
                            android:contentDescription="Phone volume up" app:icon="@drawable/ic_vol_up" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/npLibrary" style="@style/NpButton"
                            android:contentDescription="Library" app:icon="@drawable/ic_library" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/npVol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GPS link -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/gpsCard"
            style="@style/CardBox"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">
                <TextView style="@style/CardLabel" android:text="GPS link" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:id="@+id/gpsDot"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/circle_icon_bg" />
                    <TextView
                        android:id="@+id/gpsState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textColor="@color/white"
                        android:textSize="40sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/gpsDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/secondaryText"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/gpsStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/white"
                    android:textSize="20sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reverse camera -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/camCard"
            style="@style/CardBox"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">
                <TextView style="@style/CardLabel" android:text="Reverse camera" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:id="@+id/camDot"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/circle_icon_bg" />
                    <TextView
                        android:id="@+id/camState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textColor="@color/white"
                        android:textSize="40sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/camDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/secondaryText"
                    android:textSize="20sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/camOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Open camera" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
