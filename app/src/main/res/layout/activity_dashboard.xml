<?xml version="1.0" encoding="utf-8"?>
<!-- Tablet home: clock, speed and GPS status, the setup line, Camera and Settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/carBg"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/frame" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:orientation="vertical" android:padding="@dimen/sp6">
        <TextClock style="@style/T.Display" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="H:mm" />
        <TextView android:id="@+id/speedText" style="@style/T.Title" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp2" android:text="-- km/h" />
        <TextView android:id="@+id/gpsText" style="@style/T.Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp2" />
        <TextView android:id="@+id/setupBanner" style="@style/T.Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp6" android:minHeight="48dp" android:maxLines="3"
            android:background="@drawable/bg_glass" android:gravity="center_vertical" android:padding="@dimen/sp3"
            android:textColor="?attr/carText" android:visibility="gone" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp6" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/camBtn" style="@style/CarButton"
                android:text="Camera" app:icon="@drawable/ic_record" />
            <com.google.android.material.button.MaterialButton android:id="@+id/settingsBtn" style="@style/CarButton"
                android:layout_marginStart="@dimen/sp4" android:text="Settings" app:icon="@drawable/ic_settings"
                />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
