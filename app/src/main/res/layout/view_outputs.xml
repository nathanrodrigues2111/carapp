<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, Audio: JBL speaker over Bluetooth and the tablet over Wi-Fi. Bound by Ui.bindOutputs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/outputsCard" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:divider="@drawable/divider_hair" android:orientation="vertical" android:showDividers="middle">

    <LinearLayout style="@style/SetRow.Stack" android:id="@+id/btBox" android:visibility="gone">
        <TextView android:id="@+id/btNote" style="@style/SetSub" android:maxLines="2" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btEnable" style="@style/CarButton"
            android:layout_marginTop="@dimen/sp2" android:text="Turn on Bluetooth" />
    </LinearLayout>

    <LinearLayout style="@style/SetRow.Stack">
        <LinearLayout android:id="@+id/outJblRow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:minHeight="48dp">
            <ImageView android:id="@+id/outJblIcon" android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_speaker" app:tint="?attr/carText" />
            <LinearLayout style="@style/SetTexts" android:layout_marginStart="@dimen/sp4">
                <TextView android:id="@+id/outJblName" style="@style/SetTitle" android:text="JBL speaker" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <View android:id="@+id/outJblDot" style="@style/Dot" android:layout_width="8dp" android:layout_height="8dp" />
                    <TextView android:id="@+id/outJblChip" style="@style/T.Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="@dimen/sp2" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/outJblPct" style="@style/SetValue" />
        </LinearLayout>
        <com.google.android.material.slider.Slider android:id="@+id/outJblSlider" style="@style/CarSlider"
            android:layout_marginHorizontal="-16dp" android:contentDescription="JBL speaker volume" />
    </LinearLayout>

    <LinearLayout style="@style/SetRow.Stack">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
            android:minHeight="48dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tablet"
                app:tint="?attr/carText" />
            <LinearLayout style="@style/SetTexts" android:layout_marginStart="@dimen/sp4">
                <TextView style="@style/SetTitle" android:text="Tablet speaker" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <View android:id="@+id/outTabDot" style="@style/Dot" android:layout_width="8dp" android:layout_height="8dp" />
                    <TextView android:id="@+id/outTabChip" style="@style/T.Label" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="@dimen/sp2" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/outTabPct" style="@style/SetValue" />
        </LinearLayout>
        <com.google.android.material.slider.Slider android:id="@+id/outTabSlider" style="@style/CarSlider"
            android:layout_marginHorizontal="-16dp" android:contentDescription="Tablet speaker volume" />
    </LinearLayout>
</LinearLayout>
