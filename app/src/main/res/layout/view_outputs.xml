<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, Audio: JBL over Bluetooth and the tablet over Wi-Fi. Bound by Ui.bindOutputs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/outputsCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView android:id="@+id/btNote" style="@style/T.Label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="3" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btEnable"
        style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content"
        android:layout_height="56dp" android:text="Turn on Bluetooth" android:visibility="gone" />

    <LinearLayout android:id="@+id/outJblRow" android:layout_width="match_parent" android:layout_height="64dp"
        android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/outJblIcon" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_speaker" app:tint="?attr/carText" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="@dimen/sp4" android:orientation="vertical">
            <TextView android:id="@+id/outJblName" style="@style/T.Title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="JBL (Bluetooth)" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <View android:id="@+id/outJblDot" style="@style/Dot" android:layout_width="8dp" android:layout_height="8dp" />
                <TextView android:id="@+id/outJblChip" style="@style/T.Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="@dimen/sp2" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/outJblPct" style="@style/T.Label" android:layout_width="56dp"
            android:layout_height="wrap_content" android:gravity="end" android:textColor="?attr/carText" />
    </LinearLayout>
    <com.google.android.material.slider.Slider android:id="@+id/outJblSlider" style="@style/CarSlider"
        android:contentDescription="JBL volume" app:trackIconActiveStart="@drawable/ic_speaker" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="@dimen/sp2"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_tablet"
            app:tint="?attr/carText" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="@dimen/sp4" android:orientation="vertical">
            <TextView style="@style/T.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tablet (Wi-Fi)" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <View android:id="@+id/outTabDot" style="@style/Dot" android:layout_width="8dp" android:layout_height="8dp" />
                <TextView android:id="@+id/outTabChip" style="@style/T.Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="@dimen/sp2" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/outTabPct" style="@style/T.Label" android:layout_width="56dp"
            android:layout_height="wrap_content" android:gravity="end" android:textColor="?attr/carText" />
    </LinearLayout>
    <com.google.android.material.slider.Slider android:id="@+id/outTabSlider" style="@style/CarSlider"
        android:contentDescription="Tablet volume" app:trackIconActiveStart="@drawable/ic_tablet" />
</LinearLayout>
