<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row: title and value, slider under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/SetRow.Stack">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout style="@style/SetTexts">
            <TextView style="@style/SetTitle" android:text="Sync trim" />
            <TextView style="@style/SetSub" android:text="Nudge the tablet if it sounds early or late" />
        </LinearLayout>
        <TextView android:id="@+id/setValue" style="@style/SetValue" />
    </LinearLayout>
    <com.google.android.material.slider.Slider android:id="@+id/setSlider" style="@style/CarSeek"
        android:layout_marginHorizontal="-16dp" android:contentDescription="Sync trim" />
</LinearLayout>
