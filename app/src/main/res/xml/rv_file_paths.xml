<?xml version="1.0" encoding="utf-8"?>
<!-- Clips live in app-private storage, so playing or sharing one means handing
     another app a content:// uri for it. Both roots are covered because
     Recordings falls back to internal storage when there is no external. -->
<paths>
    <external-files-path
        name="movies"
        path="Movies/" />
    <files-path
        name="movies_internal"
        path="Movies/" />
</paths>
