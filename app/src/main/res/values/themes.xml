<resources>
    <!-- Explicit dark palette, no dynamic color. -->
    <style name="Theme.LazyCar" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/onAccent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/onAccent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/secondaryText</item>
        <item name="colorError">@color/errorRed</item>
        <item name="colorOnError">@color/onAccent</item>
    </style>

    <!-- Per-accent overlays: set colorPrimary so every Material widget (buttons, sliders,
         switches, dialog buttons, text fields, ripples-via-primary) follows the chosen accent.
         onPrimary matches Accent.onColor (black on light accents, white on dark). -->
    <style name="AccentOverlay.Lime" parent="">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FF000000</item>
        <item name="colorSecondary">@color/accent</item>
    </style>
    <style name="AccentOverlay.Blue" parent="">
        <item name="colorPrimary">@color/accentBlue</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">@color/accentBlue</item>
    </style>
    <style name="AccentOverlay.Red" parent="">
        <item name="colorPrimary">@color/accentRed</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">@color/accentRed</item>
    </style>
    <style name="AccentOverlay.Orange" parent="">
        <item name="colorPrimary">@color/accentOrange</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">@color/accentOrange</item>
    </style>
    <style name="AccentOverlay.Purple" parent="">
        <item name="colorPrimary">@color/accentPurple</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">@color/accentPurple</item>
    </style>
    <style name="AccentOverlay.Cyan" parent="">
        <item name="colorPrimary">@color/accentCyan</item>
        <item name="colorOnPrimary">#FF000000</item>
        <item name="colorSecondary">@color/accentCyan</item>
    </style>
    <style name="AccentOverlay.White" parent="">
        <item name="colorPrimary">@color/accentWhite</item>
        <item name="colorOnPrimary">#FF000000</item>
        <item name="colorSecondary">@color/accentWhite</item>
    </style>

    <!-- AMOLED: only the window/background turn pure black; cards stay @color/card. -->
    <style name="ThemeOverlay.LazyCar.Amoled" parent="">
        <item name="android:colorBackground">@color/bgAmoled</item>
        <item name="android:windowBackground">@color/bgAmoled</item>
    </style>

    <!-- No-UI GoActivity: framework translucent, no Material widgets used -->
    <style name="Theme.Translucent" parent="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- Card section label: "PLAYER", "OUTPUT" -->
    <style name="CardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/secondaryText</item>
    </style>

    <!-- 56dp tappable row -->
    <style name="Row56">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 40dp icon circle (FrameLayout, centres a 24dp icon) -->
    <style name="IconCircle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/circle_icon_bg</item>
    </style>

    <style name="RowIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="RowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="NpButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="iconSize">32dp</item>
    </style>

    <style name="CardBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card</item>
    </style>

    <style name="ChevronIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
    </style>
</resources>
