<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The one CarApp theme, applied by Ui.apply on top of Theme.LazyCar. Colors = tokens.css roles. -->
    <style name="CarTheme.Midnight" parent="">
        <item name="carBg">#FF000000</item>
        <item name="carSurface">#0FFFFFFF</item>
        <item name="carSurfaceHigh">#1CFFFFFF</item>
        <item name="carStroke">#14FFFFFF</item>
        <item name="carText">#FFF5F5F7</item>
        <item name="carTextDim">#8FF5F5F7</item>
        <item name="carAccent">#FFF2F2F2</item>
        <item name="carScrim">#B3000000</item>
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:colorBackground">#FF000000</item>
        <item name="colorPrimary">#FFF2F2F2</item>
        <item name="colorOnPrimary">#FF000000</item>
        <item name="colorSecondary">#FFF2F2F2</item>
        <item name="colorOnSurface">#FFF5F5F7</item>
        <item name="colorOnSurfaceVariant">#8FF5F5F7</item>
    </style>
    <!-- Type: six styles, one family (sans-serif). Caption, Body, Title, Headline, Display, Hero. -->
    <style name="T">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/carText</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="T.Label">
        <item name="android:textSize">@dimen/t_caption</item>
        <item name="android:textColor">?attr/carTextDim</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="T.Overline" parent="T.Label">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
    </style>
    <style name="T.Body">
        <item name="android:textSize">@dimen/t_body</item>
        <item name="android:textColor">?attr/carTextDim</item>
    </style>
    <style name="T.Title">
        <item name="android:textSize">@dimen/t_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="T.Headline">
        <item name="android:textSize">@dimen/t_headline</item>
        <item name="android:textColor">?attr/carTextDim</item>
    </style>
    <style name="T.Display">
        <item name="android:textSize">@dimen/t_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="T.Track">
        <item name="android:textSize">@dimen/t_track</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
        <!-- One line, cut with an ellipsis. No marquee: it draws a second copy of the title and restarts on focus changes. -->
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="T.TrackSub">
        <item name="android:maxLines">2</item>
        <item name="android:textSize">@dimen/t_track_sub</item>
        <item name="android:textColor">#99F5F5F7</item>
    </style>
    <style name="T.Hero" parent="T.Display">
        <item name="android:textSize">@dimen/t_hero</item>
    </style>

    <style name="Glass">
        <item name="android:background">@drawable/bg_glass</item>
        <item name="android:padding">@dimen/sp6</item>
    </style>
    <style name="CarIconBtn">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">?attr/carText</item>
    </style>
    <style name="CarIconBtn.Big">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:padding">18dp</item>
    </style>
    <!-- Volume slider: same component as the seek bar, 0..100. -->
    <style name="CarSlider" parent="CarSeek">
        <item name="android:valueTo">100</item>
        <item name="android:stepSize">1</item>
    </style>
    <!-- Neutral pill button, the only button style besides GO. -->
    <style name="CarButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">?attr/carSurfaceHigh</item>
        <item name="android:textColor">?attr/carText</item>
        <item name="android:textAppearance">@style/T.Body</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">?attr/carText</item>
        <item name="rippleColor">?attr/carStroke</item>
    </style>
    <!-- Seek: 4dp track, 16dp round white thumb, no stop dot. -->
    <style name="CarSeek" parent="Widget.Material3.Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:valueFrom">0</item>
        <item name="android:valueTo">1</item>
        <item name="labelBehavior">gone</item>
        <item name="tickVisible">false</item>
        <item name="trackHeight">4dp</item>
        <item name="thumbWidth">16dp</item>
        <item name="thumbHeight">16dp</item>
        <item name="thumbTrackGapSize">0dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="trackInsideCornerSize">2dp</item>
        <item name="thumbElevation">2dp</item>
        <item name="haloRadius">14dp</item>
        <item name="thumbColor">?attr/carText</item>
        <item name="haloColor">#1FFFFFFF</item>
        <item name="trackColorActive">?attr/carText</item>
        <item name="trackColorInactive">#1FFFFFFF</item>
    </style>
    <style name="Dot">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:background">@drawable/bg_dot</item>
    </style>
    <!-- Settings: small caps header outside the card, one card per section, rows with hairlines. -->
    <style name="SectionHeader" parent="T.Overline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/sp6</item>
        <item name="android:layout_marginBottom">@dimen/sp2</item>
        <item name="android:layout_marginStart">@dimen/row_pad</item>
    </style>
    <style name="SetCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_glass</item>
        <item name="android:showDividers">middle</item>
        <item name="android:divider">@drawable/divider_hair</item>
    </style>
    <!-- Row: title + one line subtitle on the left, control right aligned. -->
    <style name="SetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/row_min</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/row_pad</item>
        <item name="android:paddingVertical">@dimen/sp3</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <!-- Row whose control sits under the title (swatches, pills, sliders). -->
    <style name="SetRow.Stack">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">start</item>
        <item name="android:paddingVertical">@dimen/sp4</item>
        <item name="android:background">@null</item>
    </style>
    <style name="SetTexts">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="SetTitle" parent="T.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/carText</item>
    </style>
    <style name="SetSub" parent="T.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="SetValue" parent="T.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/sp3</item>
    </style>
    <style name="SetSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/sp3</item>
    </style>
    <style name="Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/t_body</item>
        <item name="android:textColor">?attr/carTextDim</item>
    </style>
    <!-- Text field: filled pill, no outline. -->
    <style name="CarField" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">?attr/carSurfaceHigh</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/r_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/r_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/r_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/r_m</item>
        <item name="hintTextColor">?attr/carTextDim</item>
        <item name="android:textColorHint">?attr/carTextDim</item>
    </style>
    <style name="CarFieldText" parent="T.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/carText</item>
        <item name="android:inputType">text</item>
    </style>
</resources>
